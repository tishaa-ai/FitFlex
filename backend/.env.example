# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored, so your passwords and keys never get committed.
# Every line is optional: anything left out uses the default from application.properties.

# ----- MySQL -----
DB_URL=jdbc:mysql://localhost:3306/fitflex_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ----- JWT -----
# Any long random string (at least 32 characters). In PowerShell you can generate one with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ----- Frontend origins allowed by CORS (comma separated) -----
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ----- External APIs (optional: the app works without them) -----
# Free key: https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY=
# Server-side key with "Places API" enabled. Without it, OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=
